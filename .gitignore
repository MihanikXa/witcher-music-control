# Reference directories contain third-party author assets: keep all actual contents local.
/reference/**/*
!/reference/**/
!/reference/**/README.md

# Generated resources and deployable builds
/build/*
!/build/README.md
/deploy/*
!/deploy/README.md

# Local tools, artifacts, resource dumps and binaries
.local/
*.zip
*.7z
*.rar
