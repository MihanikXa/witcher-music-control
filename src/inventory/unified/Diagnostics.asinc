      // Off by default. Private diagnostic build opts in explicitly.
      protected var aiDiagnosticBuild:Boolean=false;
      protected var aiDiagnosticText:TextField;
      protected var aiEvidenceLines:Array=[];
      protected var aiEvidenceSummary:Object={};
      protected var aiFault:Boolean=false;
      protected var aiRefreshDispatches:uint=0;
      public function approvedEvidence(message:String) : void {aiEvidence("script",message);}
      protected function aiEvidence(step:String,detail:String="") : void
      {
         if(!SlotBase.aiDiagnostics)return;
         var line:String=String(getTimer())+" "+step+" "+detail;
         trace("ApprovedEvidence "+line);aiEvidenceLines.push(line);
         if(step=="script" && (detail.indexOf("owned=")==0 || detail.indexOf("publish=")==0))aiEvidenceSummary[detail.split("=")[0]]=detail;
         if(step=="script" && detail.indexOf("refresh.request")==0)aiEvidenceSummary["ack"]=detail;
         if(step=="binding.items")aiEvidenceSummary["binding"]=detail;
         if(step=="rail.icon.skipped" && !aiEvidenceSummary["iconFault"])aiEvidenceSummary["iconFault"]="FIRST OPTIONAL ICON FAULT: "+detail;
         if(aiEvidenceLines.length>12)aiEvidenceLines.shift();
         if(!aiDiagnosticText)
         {
            aiDiagnosticText=aiText(this,"",730,540,510,15,0xFFFFFF);
            aiDiagnosticText.height=425;aiDiagnosticText.multiline=true;aiDiagnosticText.wordWrap=true;
            aiDiagnosticText.background=true;aiDiagnosticText.backgroundColor=0x111111;
         }
         aiDiagnosticText.text="DIAGNOSTIC ONLY - F8 snapshot / overlay\n"+String(aiEvidenceSummary["iconFault"]||"")+"\nREFRESH SENT="+aiRefreshDispatches+" SCRIPT="+String(aiEvidenceSummary["ack"]||"not received")+"\n"+String(aiEvidenceSummary["owned"]||"owned: not received")+"\n"+String(aiEvidenceSummary["publish"]||"publish: not received")+"\nBINDING="+String(aiEvidenceSummary["binding"]||"not received")+"\n"+aiEvidenceLines.join("\n");
         setChildIndex(aiDiagnosticText,numChildren-1);
      }
      protected function aiData(value:Array) : void
      {
         try {aiDataApply(value);}
         catch(error:Error){aiFault=true;aiEvidence("binding.FAULT",error.name+" #"+error.errorID+" "+error.message);}
      }
      protected function aiPayload(e:Event) : void
      {
         aiEvidence("payload.receive");
         try {aiPayloadApply(e);}
         catch(error:Error){aiFault=true;aiEvidence("details.FAULT",error.name+" #"+error.errorID+" "+error.message);}
      }
      protected function aiDescribe(o:DisplayObject) : String
      {
         if(!o)return "null";
         var r:Rectangle=o.getBounds(this);var m:Matrix=o.transform.concatenatedMatrix;
         return o.name+" parent="+(o.parent?o.parent.name:"null")+" v="+o.visible+" a="+o.alpha+
            " bounds="+[r.x,r.y,r.width,r.height].join(",")+" matrix="+m.toString()+" mask="+(o.mask?o.mask.name:"none");
      }
      public function aiSnapshot() : void
      {
         aiEvidence("state","active="+aiActive+" fault="+aiFault+" group="+aiGroup+" focus="+aiFocus+" all="+aiAll.length+" id="+aiCurrentID+" serial="+aiRequestSerial);
         aiEvidence("module",aiDescribe(mcPlayerInventory));
         aiEvidence("tabs",aiDescribe(mcPlayerInventory.mcTabList));
         aiEvidence("title",aiDescribe(mcPlayerInventory.txtTitle));
         aiEvidence("grid",aiDescribe(mcPlayerInventory.mcPlayerGrid));
         mcPlayerInventory.mcPlayerGrid.aiSnapshot();
         aiEvidence("details",aiDescribe(aiTip));
         aiEvidence("paperdoll",aiDescribe(mcPaperDollModule));
         var targets:String="";
         for(var i:int=1;i<=20;i++)
         {
            var target:DisplayObject=mcPaperDollModule["mcPaperDollSlot"+i] as DisplayObject;
            targets+=i+":"+(target?String(target.visible):"null")+" ";
         }
         aiEvidence("targets.visible",targets);
         aiEvidence("model",aiDescribe(mcCharacterRenderer));
      }
